{:paths   ["src"]

 :deps    {org.clojure/clojurescript {:mvn/version "1.12.145"}
           reagent/reagent           {:mvn/version "2.0.1"}}

 :aliases {:dev   {:extra-paths ["test" "dev"]
                   :extra-deps  {ch.qos.logback/logback-classic {:mvn/version "1.6.5"}}}

           :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                                slipset/deps-deploy           {:mvn/version "0.2.2"}}
                   :ns-default build}

           :codox {:replace-paths ["src"]
                   :extra-paths   ["scripts"]
                   :extra-deps    {codox/codox {:mvn/version "0.10.8"}}
                   :project       {}
                   :exec-fn       codox-build/generate-docs
                   :exec-args     {:source-paths ["src"]
                                   :name         "Cartoj"
                                   :description  "ClojureScript Reagent components for interactive maps backed by MapLibre and react-map-gl."
                                   :output-path  "docs"
                                   :language     :clojurescript
                                   :html         {:transforms
                                                  [[:#header]
                                                    [:prepend
                                                     [:a {:href "https://github.com/perrygeo/cartoj"
                                                          :class "github-link"
                                                          :style "float:right; display:inline-block; line-height:18px; margin:1px 6px 0 0; color:#f5f5f5; text-decoration:none; font-size:10pt;"}
